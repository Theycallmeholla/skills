# how-are-we-doing: keys for ONE business.
# Copy to <profile folder>/.env and fill in only the sources this business uses.
# This file must never be committed: keep .claude/how-are-we-doing/ in .gitignore.
# The profile names each key (sources.<name>.env_key). If a key already lives in the
# project's own env file, point at that instead with env_file and leave it out of here.
# After editing, run:  python3 <skill dir>/scripts/pull.py --profile <profile folder> --check

# Microsoft Clarity metrics (scroll depth, dead/rage clicks per page).
# Clarity > Settings > Data Export > Generate new API token (project admins only).
# Limit: 10 calls per project per day.
CLARITY_EXPORT_TOKEN=

# GoHighLevel leads (bookings, tags, pipeline).
# Sub-account > Settings > Private Integrations > new token with read access to
# contacts, calendars/events and opportunities.
GHL_PRIVATE_INTEGRATION_KEY=

# Ahrefs Domain Rating. Ahrefs account > API keys. A free/public-tier key is enough.
AHREFS_API_KEY=

# Search Console and GA4 don't use this file. They use a Google service-account JSON
# key: set sources.gsc.key_file (and sources.ga4.key_file) to its path. Then add the
# key's client_email as a Full user in Search Console and as Viewer in GA4.
